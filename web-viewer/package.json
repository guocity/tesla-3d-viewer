{
  "name": "tesla-web-viewer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "node scripts/prepare-assets.js && vite --host 127.0.0.1",
    "build": "node scripts/prepare-assets.js && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test",
    "prepare:assets": "node scripts/prepare-assets.js",
    "build:pages": "node scripts/prepare-assets.js --prepared && vite build"
  },
  "dependencies": {
    "@rive-app/webgl2": "2.45.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "vite": "8.3.5"
  }
}
